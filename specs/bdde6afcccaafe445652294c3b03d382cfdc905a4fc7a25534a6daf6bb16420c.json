[
  {
    "function_v0": {
      "doc": "Buys tokens with up to `quote_in` quote (fee included). Reverts unless at least `min_tokens_out`\\n(strictly positive) tokens are delivered. A buy that would cross the graduation target is CLAMPED:\\nonly the quote needed to reach the target is charged and the remainder stays with the buyer, so the\\ncall is a partial fill, never a revert. Returns the tokens delivered.",
      "name": "buy",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "quote_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_tokens_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "CurveError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Sells `tokens_in` back to the curve. Reverts unless at least `min_quote_out` (strictly positive) quote\\nis paid out. Allowed in `Trading` and `Graduatable` (holders are never locked in while a graduation is\\npending); a sell that takes `real_quote` below the target moves the phase back to `Trading`.",
      "name": "sell",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "tokens_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_quote_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "CurveError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
