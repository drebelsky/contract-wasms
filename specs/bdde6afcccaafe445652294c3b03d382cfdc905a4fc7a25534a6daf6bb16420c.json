  {
    "udt_enum_v0": {
      "doc": "Lifecycle: `Trading -> Graduatable -> Graduating -> Graduated`.\\n- `Graduatable` is STICKY: it is entered once `real_quote` reaches the target and never left. Buys are\\nclosed from then on; sells keep working until the first graduation step.\\n- `Graduating` starts with the first graduation step (the pool step). All trading is closed.\\n- `Graduated` is terminal (the last market step ran).\\n`Graduating = 3` keeps the stage 1 numbering (`Graduated = 2`) stable for existing readers.",
      "lib": "",
      "name": "Phase",
      "cases": [
        {
          "doc": "",
          "name": "Trading",
          "value": 0
        },
        {
          "doc": "",
          "name": "Graduatable",
          "value": 1
        },
        {
          "doc": "",
          "name": "Graduated",
          "value": 2
        },
        {
          "doc": "",
          "name": "Graduating",
          "value": 3
        }
      ]
    }
  },
