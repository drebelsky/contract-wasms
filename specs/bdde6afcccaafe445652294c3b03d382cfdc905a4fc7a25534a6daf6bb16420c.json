  {
    "udt_struct_v0": {
      "doc": "Immutable economic parameters of one launch.\\n\\nReserve naming: `virtual_quote` and `virtual_token` are the initial virtual reserves; the curve invariant is\\n`(virtual_quote + real_quote) * (virtual_token - sold) >= k` with `k = virtual_quote * virtual_token`.",
      "lib": "",
      "name": "CurveParams",
      "fields": [
        {
          "doc": "Cumulative creator buy cap in bps of `curve_supply`.",
          "name": "creator_cap_bps",
          "type_": "u32"
        },
        {
          "doc": "Share of each trade fee that accrues to the creator (rest to the treasury), in bps of the fee.",
          "name": "creator_fee_share_bps",
          "type_": "u32"
        },
        {
          "doc": "Tokens that can be sold along the curve.",
          "name": "curve_supply",
          "type_": "i128"
        },
        {
          "doc": "Real quote (net of fees) at which trading stops and the curve becomes graduatable.",
          "name": "graduation_target",
          "type_": "i128"
        },
        {
          "doc": "Tokens reserved for the liquidity pool at graduation (stage 2).",
          "name": "lp_supply",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "trade_fee_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "virtual_quote",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "virtual_token",
          "type_": "i128"
        }
      ]
    }
  },
