  {
    "function_v0": {
      "doc": "Atomic purchase of a Robinhood stock SAC (`stock_token`) paying in `USDC`, `USDT0` (`LayerZero`),\\n`XLD`, or `SPY` (correlated index asset) from the RWA Router's non-custodial liquidity buffer, enforcing:\\n- Stock-Split / Gap Halt check (`!quote.split_or_gap_halted`)\\n- `USDT0` Peg Health Guard (`usdt0_peg_stroops >= $0.9850 USDC`)\\n- 3-Tier Dynamic Fee (`0 bps` CompanyBot, `15 bps` PartnerWholesale, `30 bps` Retail) split 50/50 to `Vault V4` & `OperatorWallet`.",
      "name": "buy_rwa_stock",
      "inputs": [
        {
          "doc": "",
          "name": "buyer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "pay_token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "stock_token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "pay_amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_stock_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
