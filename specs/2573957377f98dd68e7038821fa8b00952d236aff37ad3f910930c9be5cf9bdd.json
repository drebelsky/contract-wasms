  {
    "function_v0": {
      "doc": "Bridges `amount` (7-dec) of the user's USDC to `destination_domain`. Keeps the fee and burns\\n`net` via CCTP with the user as `caller`. Returns `net`.\\n\\n`approve_live_until` must come from the client (latest ledger + ~500): ledger-derived values in\\nthe arguments of an authorized sub-call break auth between simulation and apply (brief \\xc2\\xa72.4).",
      "name": "bridge",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "destination_domain",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "mint_recipient",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "max_fee",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_net_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "approve_live_until",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
