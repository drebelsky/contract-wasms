  {
    "function_v0": {
      "doc": "Only the market can deposit. Pulls exactly `token.transfer(market, this, amounts_desired[0])` (the\\ncall the receipt-vault pre-authorizes), supplies it to the Blend fee vault and mints shares against\\nthe position value measured BEFORE the supply. `invest` is ignored (always invests).",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "amounts_desired",
          "type_": {
            "vec": {
              "element_type": "i128"
            }
          }
        },
        {
          "doc": "",
          "name": "amounts_min",
          "type_": {
            "vec": {
              "element_type": "i128"
            }
          }
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "invest",
          "type_": "bool"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "vec": {
                "element_type": "i128"
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
