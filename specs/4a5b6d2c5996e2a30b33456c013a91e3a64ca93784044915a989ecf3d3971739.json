    "function_v0": {
      "doc": "Burns `shares` of `from` and pays the pro-rata underlying (round down) to `from`. Withdrawals stay\\nopen while paused. Fails with `LiquidityShortfall` (and changes nothing) if the Blend pool cannot\\nrelease the funds.",
      "name": "withdraw",
      "inputs": [
        {
          "doc": "",
          "name": "shares",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_amounts_out",
          "type_": {
            "vec": {
              "element_type": "i128"
            }
          }
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "vec": {
                "element_type": "i128"
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "`principal` is the underlying still deposited (pro rata), so `total_value - principal` is the net\\nyield after the fee vault's take rate. `apy_hint_bps` is 0: the fee vault does not expose a rate.",
