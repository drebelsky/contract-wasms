    "function_v0": {
      "doc": "The manager swaps `sold` of one component for `bought` of another:\\nthe fund pays out `sell` and takes in `buy` in the same transaction.\\nShares re-weight through the balances, and the trade must be worth at\\nleast 99% of what leaves the fund at oracle prices, so a manager or\\nagent can't drain value through a bad fill. Where the manager sources\\nthe bought asset (SDEX, Soroswap, an RFQ desk) is up to them.",
      "name": "rebalance",
      "inputs": [
        {
          "doc": "",
          "name": "sell",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "sold",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "buy",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "bought",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
