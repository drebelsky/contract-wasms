    "udt_union_v0": {
      "doc": "Mirrors the runtime's `RefreshStatus` so this contract needs no dependency\\non the runtime crate, whose `#[contractimpl]` exports would be linked into\\nthis wasm. The shapes must stay XDR-identical; the integration test drives a\\nreal runtime through `refresh_many` and decodes the result, so a divergence\\nfails there rather than on chain.",
      "lib": "",
      "name": "RefreshStatus",
      "cases": [
        {
          "tuple_v0": {
            "doc": "",
            "name": "Accepted",
            "type_": [
              {
                "udt": {
                  "name": "NormalizedPrice"
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "Blocked",
            "type_": [
              "u32"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "ResolveFailed",
            "type_": [
              "u32"
            ]
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "UnknownAsset"
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "SourceUnavailable"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "`refresh(asset)` on `oracle` for each asset, in order. Status-level\\nfailures come back per asset, but a trap reverts the whole batch \\xe2\\x80\\x94 and\\nan archived ledger entry in a third-party source traps below the\\nruntime's own `try_` calls, so one unrecoverable provider darkens every\\nasset in the sweep. Batch assets that share sources, and keep the\\nsweep small enough to retry.",
      "name": "refresh_many",
      "inputs": [
        {
          "doc": "",
          "name": "oracle",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "assets",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Asset"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "vec": {
            "element_type": {
              "udt": {
                "name": "RefreshStatus"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Renew `oracle`'s instance and code, then `extend_ttl(asset)` on it for\\neach asset; `false` marks an asset the runtime rejected (unregistered).",
