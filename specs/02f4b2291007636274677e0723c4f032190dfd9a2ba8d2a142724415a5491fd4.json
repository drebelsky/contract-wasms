    "udt_struct_v0": {
      "doc": "Soroban wire format for a 512-bit `Decimal`. Wrapping `BytesN<64>` (the\\n8 \\xc3\\x97 `u64` words of `Decimal::as_repr` laid out little-endian) gives a\\ncompile-time length guarantee at the contract boundary \\xe2\\x80\\x94 unlike a raw\\n`Vec<u64>` field, which could arrive empty, short, or oversized and\\nwould have to be re-validated by every consumer.",
      "lib": "",
      "name": "SorobanDecimal",
      "fields": [
        {
          "doc": "",
          "name": "0",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        }
      ]
    }
  },
